<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_view_form_priority_level" model="ir.ui.view">
        <field name="name">crm.lead.form.priority.level</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='date_deadline']/following-sibling::div[1]" position="after">
                <field name="x_lead_level"/>
            </xpath>

            <xpath expr="//group[@name='lead_priority']/field[@name='priority']" position="after">
                <field name="x_lead_level"/>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_list_priority_level" model="ir.ui.view">
        <field name="name">crm.lead.list.priority.level</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" eval="ref('crm.crm_case_' + 'tr' + 'ee_view_leads')"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">x_lead_level asc, create_date desc</attribute>
            </xpath>

            <xpath expr="//field[@name='priority']" position="after">
                <field name="x_lead_level"
                       string="Lead Level"
                       widget="badge"
                       optional="show"
                       decoration-danger="x_lead_level == '1'"
                       decoration-warning="x_lead_level in ('2', '3')"
                       decoration-muted="x_lead_level in ('4', '5')"/>
            </xpath>
        </field>
    </record>

    <record id="crm_opportunity_view_list_priority_level" model="ir.ui.view">
        <field name="name">crm.opportunity.list.priority.level</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" eval="ref('crm.crm_case_' + 'tr' + 'ee_view_oppor')"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">x_lead_level asc, create_date desc</attribute>
            </xpath>

            <xpath expr="//field[@name='priority']" position="after">
                <field name="x_lead_level"
                       string="Lead Level"
                       widget="badge"
                       optional="show"
                       decoration-danger="x_lead_level == '1'"
                       decoration-warning="x_lead_level in ('2', '3')"
                       decoration-muted="x_lead_level in ('4', '5')"/>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_search_priority_level" model="ir.ui.view">
        <field name="name">crm.lead.search.priority.level</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_id']" position="after">
                <field name="x_lead_level" string="Lead Level"/>
            </xpath>

            <xpath expr="//filter[@name='assigned_to_me']" position="before">
                <separator/>
                <filter string="Level 1" name="filter_lead_level_1"
                        domain="[('x_lead_level', '=', '1')]"/>
                <filter string="Level 2" name="filter_lead_level_2"
                        domain="[('x_lead_level', '=', '2')]"/>
                <filter string="Level 3" name="filter_lead_level_3"
                        domain="[('x_lead_level', '=', '3')]"/>
                <filter string="Level 4" name="filter_lead_level_4"
                        domain="[('x_lead_level', '=', '4')]"/>
                <filter string="Level 5" name="filter_lead_level_5"
                        domain="[('x_lead_level', '=', '5')]"/>
                <separator/>
            </xpath>

            <xpath expr="//group" position="inside">
                <filter string="Lead Level" name="groupby_lead_level"
                        context="{'group_by': 'x_lead_level'}"/>
            </xpath>
        </field>
    </record>

    <record id="crm_opportunity_view_search_priority_level" model="ir.ui.view">
        <field name="name">crm.opportunity.search.priority.level</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_id']" position="after">
                <field name="x_lead_level" string="Lead Level"/>
            </xpath>

            <xpath expr="//filter[@name='filter_won_status_won']" position="before">
                <separator/>
                <filter string="Level 1" name="filter_lead_level_1"
                        domain="[('x_lead_level', '=', '1')]"/>
                <filter string="Level 2" name="filter_lead_level_2"
                        domain="[('x_lead_level', '=', '2')]"/>
                <filter string="Level 3" name="filter_lead_level_3"
                        domain="[('x_lead_level', '=', '3')]"/>
                <filter string="Level 4" name="filter_lead_level_4"
                        domain="[('x_lead_level', '=', '4')]"/>
                <filter string="Level 5" name="filter_lead_level_5"
                        domain="[('x_lead_level', '=', '5')]"/>
                <separator/>
            </xpath>

            <xpath expr="//group" position="inside">
                <filter string="Lead Level" name="groupby_lead_level"
                        context="{'group_by': 'x_lead_level'}"/>
            </xpath>
        </field>
    </record>

</odoo>
