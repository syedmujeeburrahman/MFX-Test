<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_erp_system_list" model="ir.ui.view">
        <field name="name">x_erp.crm_erp_system.list</field>
        <field name="model">x_erp.crm_erp_system</field>
        <field name="arch" type="xml">
            <list string="ERP Systems">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_crm_erp_system_form" model="ir.ui.view">
        <field name="name">x_erp.crm_erp_system.form</field>
        <field name="model">x_erp.crm_erp_system</field>
        <field name="arch" type="xml">
            <form string="ERP System">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_erp_systems" model="ir.actions.act_window">
        <field name="name">ERP Systems</field>
        <field name="res_model">x_erp.crm_erp_system</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_crm_contact_type_list" model="ir.ui.view">
        <field name="name">x_erp.crm_contact_type.list</field>
        <field name="model">x_erp.crm_contact_type</field>
        <field name="arch" type="xml">
            <list string="Contact Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_crm_contact_type_form" model="ir.ui.view">
        <field name="name">x_erp.crm_contact_type.form</field>
        <field name="model">x_erp.crm_contact_type</field>
        <field name="arch" type="xml">
            <form string="Contact Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_contact_types" model="ir.actions.act_window">
        <field name="name">Contact Types</field>
        <field name="res_model">x_erp.crm_contact_type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_crm_erp_systems"
              name="ERP Systems"
              parent="crm.menu_crm_config_lead"
              action="action_crm_erp_systems"
              sequence="25"/>

    <menuitem id="menu_crm_contact_types"
              name="Contact Types"
              parent="crm.menu_crm_config_lead"
              action="action_crm_contact_types"
              sequence="26"/>

</odoo>
