<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit crm.lead Form View -->
    <record id="crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.crm_lead_management</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Add Lead Type badge next to priority stars -->
            <xpath expr="//field[@name='priority']" position="after">
                <field name="x_lead_type" widget="badge"
                       decoration-danger="x_lead_type == 'hot'"
                       decoration-warning="x_lead_type == 'warm'"
                       decoration-info="x_lead_type == 'cold'"/>
                <field name="x_erp_system_id" options="{'no_create_edit': True}"/>
                <field name="x_contact_type_id" options="{'no_create_edit': True}"/>
            </xpath>

            <!-- Add Lead Level in the opportunity and lead priority areas -->
            <xpath expr="//label[@for='date_deadline']/following-sibling::div[1]" position="after">
                <field name="x_lead_level"/>
            </xpath>

            <xpath expr="//group[@name='lead_priority']/field[@name='priority']" position="after">
                <field name="x_lead_level"/>
            </xpath>

            <!-- Add Next Follow-up Date in the main info area -->
            <xpath expr="//field[@name='date_deadline']" position="after">
                <field name="x_next_followup_date"/>
            </xpath>

        </field>
    </record>

</odoo>
