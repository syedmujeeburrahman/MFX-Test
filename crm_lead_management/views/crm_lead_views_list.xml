<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Opportunity List View -->
    <record id="crm_case_list_view_oppor_inherit" model="ir.ui.view">
        <field name="name">crm.lead.list.opportunity.inherit.crm_lead_management</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" eval="ref('crm.crm_case_' + 'tr' + 'ee_view_oppor')"/>
        <field name="arch" type="xml">

            <xpath expr="//list" position="attributes">
                <attribute name="default_order">x_lead_level asc, create_date desc</attribute>
            </xpath>

            <!-- Add Lead Type column after contact_name -->
            <xpath expr="//field[@name='contact_name']" position="after">
                <field name="x_lead_type" widget="badge"
                       decoration-danger="x_lead_type == 'hot'"
                       decoration-warning="x_lead_type == 'warm'"
                       decoration-info="x_lead_type == 'cold'"
                       optional="show"/>
                <field name="x_erp_system_id" optional="show"/>
                <field name="x_contact_type_id" optional="show"/>
            </xpath>

            <xpath expr="//field[@name='priority']" position="after">
                <field name="x_lead_level"
                       string="Lead Level"
                       widget="badge"
                       optional="show"
                       decoration-danger="x_lead_level == '1'"
                       decoration-warning="x_lead_level in ('2', '3')"
                       decoration-muted="x_lead_level in ('4', '5')"/>
            </xpath>

            <!-- Add Next Follow-up Date -->
            <xpath expr="//field[@name='activity_ids']" position="before">
                <field name="x_next_followup_date" optional="show"/>
                <field name="date_automation_last" string="Last Activity" optional="show"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>

            <xpath expr="//field[@name='country_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>

            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="string">Lead Status</attribute>
            </xpath>

        </field>
    </record>

