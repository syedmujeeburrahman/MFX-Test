<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="crm_lead_management.CountryDropdown">
        <div class="o_lead_filter_dropdowns d-flex align-items-center gap-1 flex-wrap">
            <t t-foreach="this._visibleFilters()" t-as="filter" t-key="filter.key">
                <div t-attf-class="o_lead_filter_dropdown d-inline-flex align-items-center {{ state.open[filter.key] ? 'o_dropdown_open' : '' }}">
                    <Dropdown menuClass="'o_lead_filter_dropdown_menu'"
                              beforeOpen="() => this.onBeforeOpen(filter)"
                              onStateChanged="(isOpen) => this.onDropdownStateChanged(filter, isOpen)">
                        <button class="btn d-flex align-items-center gap-1"
                                t-att-class="state.selectedIds[filter.key] ? 'btn-primary' : 'btn-outline-primary'">
                            <i t-attf-class="fa {{ filter.icon }}"/>
                            <span t-esc="state.labels[filter.key]"/>
                            <i t-attf-class="fa o_lead_filter_dropdown_arrow {{ state.open[filter.key] ? 'fa-chevron-down' : 'fa-chevron-right' }}"/>
                        </button>
                        <t t-set-slot="content">
                            <DropdownItem onSelected="() => this.clearFilter(filter)">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa fa-list-ul text-muted"/>
                                    <span class="fw-bold" t-esc="filter.allLabel"/>
                                </div>
                            </DropdownItem>
                            <div class="dropdown-divider" role="separator"/>
                            <t t-foreach="state.options[filter.key]" t-as="option" t-key="option.value">
                                <DropdownItem onSelected="() => this.selectOption(filter, option)">
                                    <div class="d-flex justify-content-between align-items-center w-100">
                                        <div class="d-flex align-items-center gap-2">
                                            <i t-attf-class="fa {{ filter.optionIcon }} {{ state.selectedIds[filter.key] === option.value ? 'text-primary' : 'text-muted' }}"/>
                                            <span t-att-class="state.selectedIds[filter.key] === option.value ? 'fw-bold text-primary' : ''"
                                                  t-esc="option.name"/>
                                        </div>
                                        <span class="badge rounded-pill ms-2"
                                              t-att-class="state.selectedIds[filter.key] === option.value ? 'bg-primary' : 'bg-secondary'"
                                              t-esc="option.count"/>
                                    </div>
                                </DropdownItem>
                            </t>
                            <t t-if="!state.options[filter.key].length">
                                <DropdownItem>
                                    <span class="text-muted fst-italic">No values found</span>
                                </DropdownItem>
                            </t>
                        </t>
                    </Dropdown>
                </div>
            </t>
        </div>
    </t>

