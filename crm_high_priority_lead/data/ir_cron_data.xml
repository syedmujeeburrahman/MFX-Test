<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Daily high-priority follow-up cron has been disabled.
            High-priority leads no longer get an automatic activity;
            users schedule activities manually on demand.
            The record is kept (deactivated + no-op) so existing
            installs lose the scheduled job on module upgrade
            without breaking external references to the XML id.
        -->
        <record id="ir_cron_high_priority_followup" model="ir.cron">
            <field name="name">CRM: High-Priority Follow-up Reminder (DISABLED)</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">pass</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
