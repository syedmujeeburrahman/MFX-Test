<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_prospect_sales_read_all" model="ir.rule">
        <field name="name">Prospect Registry: sales users read all</field>
        <field name="model_id" ref="model_x_erp_prospect"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_prospect_sales_write_own" model="ir.rule">
        <field name="name">Prospect Registry: sales users edit own</field>
        <field name="model_id" ref="model_x_erp_prospect"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_prospect_manager_all" model="ir.rule">
        <field name="name">Prospect Registry: managers all</field>
        <field name="model_id" ref="model_x_erp_prospect"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_prospect_activity_sales_read_all" model="ir.rule">
        <field name="name">Prospect Activity: sales users read all</field>
        <field name="model_id" ref="model_x_erp_prospect_activity"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_prospect_activity_sales_write_own" model="ir.rule">
        <field name="name">Prospect Activity: sales users edit own prospect activity</field>
        <field name="model_id" ref="model_x_erp_prospect_activity"/>
        <field name="domain_force">[('prospect_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_prospect_activity_manager_all" model="ir.rule">
        <field name="name">Prospect Activity: managers all</field>
        <field name="model_id" ref="model_x_erp_prospect_activity"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
