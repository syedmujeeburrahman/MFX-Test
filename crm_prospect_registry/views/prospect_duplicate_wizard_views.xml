<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_prospect_duplicate_wizard_form" model="ir.ui.view">
        <field name="name">x_erp.prospect_duplicate_wizard.form</field>
        <field name="model">x_erp.prospect_duplicate_wizard</field>
        <field name="arch" type="xml">
            <form string="Company Already Exists">
                <group>
                    <field name="prospect_id" invisible="1"/>
                    <field name="duplicate_id" options="{'no_create': True}"/>
                </group>
                <group string="Existing Record">
                    <field name="company_name"/>
                    <field name="salesperson_id"/>
                    <field name="current_status"/>
                    <field name="last_contact_date"/>
                </group>
                <group string="Duplicate Details">
                    <field name="duplicate_summary" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_open_existing" type="object" string="Open Existing" class="btn-primary"/>
                    <button name="action_continue_anyway" type="object" string="Continue Anyway" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
