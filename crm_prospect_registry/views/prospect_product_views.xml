<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_prospect_product_list" model="ir.ui.view">
        <field name="name">x_erp.prospect_product.list</field>
        <field name="model">x_erp.prospect_product</field>
        <field name="arch" type="xml">
            <list string="Prospect Products">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_prospect_product_form" model="ir.ui.view">
        <field name="name">x_erp.prospect_product.form</field>
        <field name="model">x_erp.prospect_product</field>
        <field name="arch" type="xml">
            <form string="Prospect Product">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_prospect_products" model="ir.actions.act_window">
        <field name="name">Products Interested</field>
        <field name="res_model">x_erp.prospect_product</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
