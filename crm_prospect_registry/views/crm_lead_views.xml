<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_view_form_source_prospect" model="ir.ui.view">
        <field name="name">crm.lead.form.source.prospect</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_source_prospect"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-address-book"
                        invisible="not x_prospect_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Source</span>
                        <span class="o_stat_value"><field name="x_prospect_id"/></span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
